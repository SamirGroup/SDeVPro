# SDeVPro sozlamalari — bu faylni ".env" nomi bilan nusxalab, o'z qiymatlaringizni kiriting.
# cp .env.example .env

# --- Telegram bot ---
# @BotFather orqali oling: Telegram'da @BotFather ga /newbot yuboring.
TELEGRAM_BOT_TOKEN=

# (Ixtiyoriy) Faqat shu Telegram foydalanuvchi ID'lariga botdan foydalanishga ruxsat berish.
# Bo'sh qoldirilsa — botga yozgan har bir kishi foydalana oladi (birinchi ishga tushirishda tavsiya etilmaydi!).
# ID'ni bilish uchun: Telegram'da @userinfobot ga yozing.
SDEVPRO_ALLOWED_USERS=
SDEVPRO_ALLOWED_USERNAMES=

# Har bir chat birinchi /scan'dan oldin vakolat borligini tasdiqlashi shartmi (tavsiya etiladi: true)
SDEVPRO_REQUIRE_CONSENT=true

# --- AI / LLM provider ---
# Strix bilan bir xil format: "<provider>/<model>"
#   openai/gpt-5.4
#   anthropic/claude-sonnet-4-6
#   gemini/gemini-3-pro-preview
#   deepseek/deepseek-v4-pro
SDEVPRO_LLM=anthropic/claude-sonnet-4-6
SDEVPRO_LLM_API_KEY=

# Mahalliy model (Ollama/LM Studio) ishlatilsa (ixtiyoriy):
# SDEVPRO_LLM_API_BASE=http://localhost:11434

# --- Skanerlash sozlamalari ---
SDEVPRO_DEFAULT_SCHEDULE_MINUTES=60
SDEVPRO_SCAN_TIMEOUT_SECONDS=600
SDEVPRO_DIRSCAN_CONCURRENCY=20

# --- Ma'lumotlar joylashuvi ---
SDEVPRO_DATA_DIR=sdevpro_data
SDEVPRO_LOG_DIR=sdevpro_data/logs

# Hisobot tili (hozircha uz qo'llab-quvvatlanadi)
SDEVPRO_REPORT_LANGUAGE=uz

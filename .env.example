# SDeVPro sozlamalari — bu faylni ".env" nomi bilan nusxalab, o'z qiymatlaringizni kiriting.
# cp .env.example .env

# --- Telegram bot ---
# @BotFather orqali oling: Telegram'da @BotFather ga /newbot yuboring.
TELEGRAM_BOT_TOKEN=

# (Ixtiyoriy) Faqat shu Telegram foydalanuvchi ID'lariga botdan foydalanishga ruxsat berish.
# Bo'sh qoldirilsa — botga yozgan har bir kishi (o'z AI tokeni bilan) foydalana oladi.
# ID'ni bilish uchun: Telegram'da @userinfobot ga yozing.
SDEVPRO_ALLOWED_USERS=
SDEVPRO_ALLOWED_USERNAMES=

# Har bir chat birinchi /scan'dan oldin vakolat borligini tasdiqlashi shartmi (tavsiya etiladi: true)
SDEVPRO_REQUIRE_CONSENT=true

# --- AI / LLM ---
# ESLATMA: standart ish rejimida HAR BIR foydalanuvchi o'z AI (LLM) tokenini
# botning /setkey buyrug'i orqali o'zi kiritadi (shifrlangan holda saqlanadi).
# Quyidagi SDEVPRO_LLM* qiymatlari faqat operatorning o'zi CLI orqali sinov
# qilmoqchi bo'lsa kerak bo'ladi — botning asosiy oqimida ishlatilmaydi.
SDEVPRO_LLM=
SDEVPRO_LLM_API_KEY=
# Mahalliy model (Ollama/LM Studio) ishlatilsa (ixtiyoriy):
# SDEVPRO_LLM_API_BASE=http://localhost:11434

# Foydalanuvchi tokenlarini (va GitHub tokenlarini) diskda shifrlash uchun kalit.
# Bo'sh qoldirsangiz ham ishlayveradi — SDeVPro <data-dir>/secret.key faylini
# birinchi ishga tushirishda o'zi avtomatik yaratadi. Serverless (Vercel)
# joylashtirishda BUNI ALBATTA QO'LGA O'RNATING (masalan `openssl rand -base64 32`
# natijasi), aks holda har cold-start'da yangi kalit yaratilib, eski
# shifrlangan tokenlar o'qib bo'lmay qoladi.
SDEVPRO_SECRET_KEY=

# --- Skanerlash sozlamalari ---
SDEVPRO_DEFAULT_SCHEDULE_MINUTES=60
SDEVPRO_SCAN_TIMEOUT_SECONDS=600
SDEVPRO_DIRSCAN_CONCURRENCY=20

# --- Ma'lumotlar saqlash backend'i ---
# "file" (standart, lokal/VPS ishga tushirish uchun) yoki "redis" (Vercel/
# serverless uchun — quyidagi Upstash sozlamalari bilan birga ishlatiladi).
SDEVPRO_STORAGE_BACKEND=file
SDEVPRO_DATA_DIR=sdevpro_data
SDEVPRO_LOG_DIR=sdevpro_data/logs

# --- Vercel/serverless uchun (ixtiyoriy) ---
# Bepul: https://upstash.com -> Redis database yarating -> REST URL/Token'ni oling.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Telegram webhook so'rovlarini tekshirish uchun ixtiyoriy maxfiy so'z
# (Telegram setWebhook chaqiruvida secret_token sifatida ham yuboriladi):
# SDEVPRO_WEBHOOK_SECRET=
# /api/cron endpointini tashqi chaqiruvlardan himoya qilish uchun:
# SDEVPRO_CRON_SECRET=
